# Real Meta WhatsApp Cloud API delivery
# The approved template body must accept five text variables in this order:
# {{1}} priority, {{2}} incident address, {{3}} response unit,
# {{4}} ETA in minutes, {{5}} dispatch reference.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_DEMO_RECIPIENT=27826502010
WHATSAPP_CLOUD_TEMPLATE_NAME=mzansimesh_security_dispatch_v1
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v23.0
# Optional free-form message. WhatsApp permits this only inside an open customer-service window.
WHATSAPP_CLOUD_MESSAGE_TEXT=

# Optional Mapbox maps and street-aware routing. Keep the real token in .env only.
MAPBOX_ACCESS_TOKEN=
